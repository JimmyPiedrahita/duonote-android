<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base background color -->
    <item>
        <color android:color="@color/background_dark" />
    </item>
    <!-- Subtle warm glow matching the Figma reference -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="500dp"
                android:startColor="#33201A12"
                android:endColor="#001A1510"
                android:centerX="0.9"
                android:centerY="0.9" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="400dp"
                android:startColor="#30242225"
                android:endColor="#00151417"
                android:centerX="0.1"
                android:centerY="0.2" />
        </shape>
    </item>
</layer-list>

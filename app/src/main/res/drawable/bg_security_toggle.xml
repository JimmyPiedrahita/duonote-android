<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="@color/accent_blue" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:gravity="right|center_vertical" android:right="3dp" android:width="16dp" android:height="16dp">
                <shape android:shape="oval">
                    <solid android:color="@color/text_on_accent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#303136" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:gravity="left|center_vertical" android:left="3dp" android:width="16dp" android:height="16dp">
                <shape android:shape="oval">
                    <solid android:color="#77787C" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#22FFFFFF"
                android:centerColor="#0AFFFFFF"
                android:endColor="#06FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="380dp"
                android:startColor="#33A7C8FF"
                android:centerColor="#0D387EFF"
                android:endColor="#00387EFF"
                android:centerX="0.8"
                android:centerY="0.2" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="420dp"
                android:startColor="#22FFB38A"
                android:centerColor="#0A5A3804"
                android:endColor="#005A3804"
                android:centerX="0.2"
                android:centerY="0.8" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#08FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#44FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#05000000" />
            <corners android:radius="21dp" />
        </shape>
    </item>

</layer-list>
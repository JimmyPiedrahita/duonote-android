<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/changePinRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnChangePinBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_button_header"
                android:contentDescription="Volver"
                android:padding="11dp"
                android:src="@drawable/ic_back"
                android:tint="@color/text_secondary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="Cambiar PIN"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="40dp"
                android:layout_height="40dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_security_icon"
                android:padding="16dp"
                android:src="@drawable/ic_security_shield"
                android:tint="@color/accent_blue" />
            <TextView
                style="@style/DuoNote.Text.Eyebrow"
                android:layout_marginTop="18dp"
                android:text="PROTECCIÓN DE ACCESO" />
            <TextView
                style="@style/DuoNote.Text.ScreenTitle"
                android:layout_marginTop="12dp"
                android:text="Confirma tu identidad" />
            <TextView
                style="@style/DuoNote.Text.Body"
                android:layout_marginTop="10dp"
                android:maxWidth="320dp"
                android:text="Actualiza tu código de desbloqueo." />
        </LinearLayout>

        <TextView style="@style/SecurityLabel" android:layout_marginTop="26dp" android:text="PIN ACTUAL" />
        <EditText
            android:id="@+id/etCurrentPin"
            style="@style/SecurityPinInput"
            android:layout_marginTop="10dp"
            android:hint="••••"
            android:inputType="numberPassword"
            android:maxLength="6" />

        <TextView style="@style/SecurityLabel" android:layout_marginTop="18dp" android:text="NUEVO PIN" />
        <EditText
            android:id="@+id/etNewPin"
            style="@style/SecurityPinInput"
            android:layout_marginTop="10dp"
            android:hint="••••"
            android:inputType="numberPassword"
            android:maxLength="6" />

        <TextView style="@style/SecurityLabel" android:layout_marginTop="18dp" android:text="CONFIRMA EL NUEVO PIN" />
        <EditText
            android:id="@+id/etNewPinConfirmation"
            style="@style/SecurityPinInput"
            android:layout_marginTop="10dp"
            android:hint="••••"
            android:inputType="numberPassword"
            android:maxLength="6" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveNewPin"
            style="@style/SecurityPrimaryButton"
            android:layout_marginTop="18dp"
            android:text="Guardar nuevo PIN"
            app:icon="@drawable/ic_lock" />
        <TextView
            android:id="@+id/btnCancelPinChange"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="Cancelar"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>

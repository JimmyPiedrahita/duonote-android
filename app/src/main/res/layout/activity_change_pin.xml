<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/changePinRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="32dp">

        <ImageButton
            android:id="@+id/btnChangePinBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_header"
            android:contentDescription="Volver"
            android:padding="11dp"
            android:src="@drawable/ic_back"
            android:tint="@color/text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_security_icon"
                android:padding="16dp"
                android:src="@drawable/ic_security_shield"
                android:tint="@color/accent_blue" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.18"
                android:text="PROTECCIÓN DE ACCESO"
                android:textColor="@color/text_secondary"
                android:textSize="9sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="Tu app está protegida"
                android:textColor="@color/text_primary"
                android:textSize="25sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:maxWidth="320dp"
                android:text="Solicita tu PIN o huella dactilar cada vez que vuelvas a DuoNote."
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            style="@style/SecurityCard"
            android:layout_marginTop="30dp"
            android:gravity="center_vertical"
            android:padding="14dp">
            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_security_icon"
                android:padding="11dp"
                android:src="@drawable/ic_lock"
                android:tint="@color/accent_blue" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView style="@style/SecurityCardTitle" android:text="Cambiar PIN" />
                <TextView style="@style/SecurityCardSubtitle" android:text="Confirma tu identidad antes de crear uno nuevo." />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/SecurityLabel" android:layout_marginTop="26dp" android:text="PIN ACTUAL" />
        <EditText
            android:id="@+id/etCurrentPin"
            style="@style/SecurityPinInput"
            android:layout_marginTop="10dp"
            android:hint="••••"
            android:inputType="numberPassword"
            android:maxLength="6" />

        <TextView style="@style/SecurityLabel" android:layout_marginTop="18dp" android:text="NUEVO PIN" />
        <EditText
            android:id="@+id/etNewPin"
            style="@style/SecurityPinInput"
            android:layout_marginTop="10dp"
            android:hint="••••"
            android:inputType="numberPassword"
            android:maxLength="6" />

        <TextView style="@style/SecurityLabel" android:layout_marginTop="18dp" android:text="CONFIRMA EL NUEVO PIN" />
        <EditText
            android:id="@+id/etNewPinConfirmation"
            style="@style/SecurityPinInput"
            android:layout_marginTop="10dp"
            android:hint="••••"
            android:inputType="numberPassword"
            android:maxLength="6" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveNewPin"
            style="@style/SecurityPrimaryButton"
            android:layout_marginTop="18dp"
            android:text="Guardar nuevo PIN" />
        <TextView
            android:id="@+id/btnCancelPinChange"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="Cancelar"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>

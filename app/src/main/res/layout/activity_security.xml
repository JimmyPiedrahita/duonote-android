<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/securityRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="42dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical">
            <ImageButton
                android:id="@+id/btnSecurityBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_button_header"
                android:contentDescription="Volver"
                android:padding="11dp"
                android:src="@drawable/ic_back"
                android:tint="@color/text_secondary" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="Seguridad"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <View android:layout_width="40dp" android:layout_height="40dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_security_icon"
                android:padding="16dp"
                android:src="@drawable/ic_security_shield"
                android:tint="@color/accent_blue" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                style="@style/DuoNote.Text.Eyebrow"
                android:text="PROTECCIÓN DE ACCESO" />
            <TextView
                android:id="@+id/tvHeroTitle"
                style="@style/DuoNote.Text.ScreenTitle"
                android:layout_marginTop="12dp" />
            <TextView
                style="@style/DuoNote.Text.Body"
                android:layout_marginTop="10dp"
                android:maxWidth="320dp"
                android:text="Solicita tu PIN o huella dactilar cada vez que vuelvas a DuoNote." />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/setupContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="vertical">
            <TextView style="@style/SecurityLabel" android:text="CREA UN PIN" />
            <EditText
                android:id="@+id/etSetupPin"
                style="@style/SecurityPinInput"
                android:layout_marginTop="10dp"
                android:hint="••••"
                android:inputType="numberPassword"
                android:maxLength="6" />
            <TextView style="@style/SecurityLabel" android:layout_marginTop="18dp" android:text="CONFIRMA TU PIN" />
            <EditText
                android:id="@+id/etSetupConfirmation"
                style="@style/SecurityPinInput"
                android:layout_marginTop="10dp"
                android:hint="••••"
                android:inputType="numberPassword"
                android:maxLength="6" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreatePin"
                style="@style/SecurityPrimaryButton"
                android:layout_marginTop="18dp"
                android:text="Activar bloqueo"
                app:icon="@drawable/ic_lock" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/setupHint"
            style="@style/SecurityCard"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:padding="15dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_fingerprint"
                android:tint="@color/accent_blue" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="13dp" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/SecurityCardTitle" android:text="Huella después del PIN" />
                <TextView style="@style/SecurityCardSubtitle" android:text="Podrás activarla una vez que configures tu código de respaldo." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/optionsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="vertical">
            <LinearLayout style="@style/SecurityCard" android:gravity="center_vertical" android:padding="14dp">
                <TextView android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bg_security_status" android:gravity="center" android:text="✓" android:textColor="@color/status_green" android:textSize="18sp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="13dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/SecurityCardTitle" android:text="Bloqueo con PIN" />
                    <TextView style="@style/SecurityCardSubtitle" android:text="Activado" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/btnBiometric" style="@style/SecurityCard" android:layout_marginTop="10dp" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:padding="14dp">
                <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_fingerprint" android:tint="@color/accent_blue" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="13dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/SecurityCardTitle" android:text="Huella dactilar" />
                    <TextView android:id="@+id/tvBiometricState" style="@style/SecurityCardSubtitle" />
                </LinearLayout>
                <View android:id="@+id/biometricToggle" style="@style/SecurityToggle" />
            </LinearLayout>
            <LinearLayout android:id="@+id/btnChangePin" style="@style/SecurityCard" android:layout_marginTop="10dp" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:padding="14dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_lock" android:tint="@color/accent_blue" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="13dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/SecurityCardTitle" android:text="Cambiar PIN" />
                    <TextView style="@style/SecurityCardSubtitle" android:text="Actualiza tu código de desbloqueo" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="→" android:textColor="@color/text_secondary" android:textSize="18sp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLockNow"
                style="@style/SecurityPrimaryButton"
                android:layout_marginTop="16dp"
                android:text="Bloquear ahora"
                app:icon="@drawable/ic_lock" />
            <TextView android:id="@+id/btnDisableSecurity" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:text="Desactivar bloqueo" android:textColor="@color/error_muted" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

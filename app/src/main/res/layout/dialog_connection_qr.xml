<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp">

            <ImageView
                android:id="@+id/ivConnectionQr"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:background="@drawable/bg_qr_code"
                android:contentDescription="Código QR de conexión"
                android:padding="12dp" />

            <TextView
                style="@style/DuoNote.Text.Eyebrow"
                android:layout_marginTop="22dp"
                android:text="ID DE CONEXIÓN" />

            <TextView
                android:id="@+id/tvDialogConnectionCode"
                style="@style/DuoNote.Text.MonoValue"
                android:layout_marginTop="8dp"
                android:textSize="20sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseConnectionQr"
                style="@style/DuoNote.ButtonPrimary"
                android:layout_marginTop="26dp"
                android:text="Cerrar" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>

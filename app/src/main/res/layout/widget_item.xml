<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
        android:padding="14dp"
    android:gravity="center_vertical"
    android:background="@color/widget_background">

    <TextView
        android:id="@+id/note_item_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
            android:textSize="13sp"
        android:textColor="@color/widget_text_pending"
        android:paddingEnd="8dp"/>

    <ImageButton
        android:id="@+id/note_item_link"
            android:layout_width="36dp"
            android:layout_height="36dp"
        android:contentDescription="Open Link"
        android:background="@color/transparent"
        android:src="@drawable/ic_link"
        android:scaleType="centerInside"
            android:padding="5dp"
        android:visibility="gone"/>

    <ImageButton
        android:id="@+id/note_item_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
        android:contentDescription="@string/description_button_copy"
        android:background="@color/transparent"
        android:src="@drawable/ic_copy_text"
        android:scaleType="centerInside"
            android:padding="5dp"
        android:layout_marginEnd="4dp"/>

    <ImageButton
        android:id="@+id/note_item_delete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="Delete Note"
        android:background="@color/transparent"
        android:src="@drawable/ic_delete"
        android:scaleType="centerInside"
        android:padding="5dp"/>

</LinearLayout>
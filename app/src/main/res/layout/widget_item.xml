<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp"
    android:gravity="center_vertical"
    android:background="@drawable/bg_ripple_note_pending">

    <TextView
        android:id="@+id/note_item_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minHeight="30dp"
        android:gravity="center_vertical"
        android:fontFamily="sans-serif"
        android:lineSpacingMultiplier="1.4"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:paddingEnd="6dp"/>

    <ImageButton
        android:id="@+id/note_item_link"
            android:layout_width="30dp"
            android:layout_height="30dp"
        android:contentDescription="Open Link"
        android:background="@color/transparent"
        android:src="@drawable/ic_link"
        android:scaleType="centerInside"
        android:tint="@color/text_secondary"
            android:padding="4dp"
        android:visibility="gone"/>

    <ImageButton
        android:id="@+id/note_item_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
        android:contentDescription="@string/description_button_copy"
        android:background="@color/transparent"
        android:src="@drawable/ic_copy_text"
        android:scaleType="centerInside"
        android:tint="@color/text_secondary"
            android:padding="4dp"/>

    <ImageButton
        android:id="@+id/note_item_delete"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:contentDescription="Delete Note"
        android:background="@color/transparent"
        android:src="@drawable/ic_delete"
        android:scaleType="centerInside"
        android:tint="@color/text_secondary"
        android:padding="4dp"/>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_panel">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/bg_widget_header">

        <TextView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="9dp"
            android:background="@drawable/bg_widget_dot" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:letterSpacing="-0.02"
            android:text="Mis notas"
            android:textColor="@color/widget_text_pending"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/widget_background">

        <ListView
            android:id="@+id/widget_list_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/transparent"
            android:dividerHeight="6dp"
            android:listSelector="@color/transparent"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@android:id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/widget_empty"
                android:textColor="@color/widget_text_pending"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="sans-serif"
                android:text="@string/widget_empty_hint"
                android:textColor="@color/widget_text_completed"
                android:textSize="9sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/header_widget"
        android:layout_width="match_parent"
        android:layout_height="57dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@color/widget_toolbar_background">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/visibilityButton"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@color/transparent"
                android:contentDescription="Toggle visibility"
                android:padding="6dp"
                android:src="@drawable/ic_visibility_on"
                android:tint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/widget_hide"
                android:textColor="@color/widget_text_completed"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/refreshButton"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@color/transparent"
                android:contentDescription="Refresh notes"
                android:padding="6dp"
                android:src="@drawable/ic_refresh_widget"
                android:tint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/widget_refresh"
                android:textColor="@color/widget_text_completed"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="44dp">

                <ImageButton
                    android:id="@+id/imageButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_widget_add"
                    android:contentDescription="@string/description_button_add"
                    android:paddingTop="4dp"
                    android:paddingBottom="16dp"
                    android:src="@drawable/ic_add_notes"
                    android:tint="@color/text_on_accent" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:gravity="center"
                    android:paddingBottom="5dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/widget_add"
                    android:textColor="@color/text_on_accent"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

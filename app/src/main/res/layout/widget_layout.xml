<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:padding="0dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ListView
        android:id="@+id/widget_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:dividerHeight="6dp"
        android:scrollbars="none"
        android:divider="@color/transparent"
        android:listSelector="@color/transparent"
        android:background="@android:color/transparent"
        android:paddingTop="0dp"
        android:paddingBottom="8dp"/>

    <LinearLayout
        android:id="@+id/header_widget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:background="@drawable/bg_widget_item"
        android:padding="8dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:layout_weight="0">

        <ImageButton
            android:id="@+id/visibilityButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_visibility_on"
            android:background="@drawable/bg_ripple_widget_note"
            android:contentDescription="Toggle visibility"
            android:scaleType="centerInside"
            android:padding="4dp"
            android:layout_marginEnd="8dp"/>

        <ImageButton
            android:id="@+id/refreshButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_refresh_widget"
            android:background="@drawable/bg_ripple_widget_note"
            android:contentDescription="Refresh notes"
            android:scaleType="centerInside"
            android:padding="4dp"
            android:layout_marginEnd="8dp"/>

        <ImageButton
            android:id="@+id/imageButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_add_notes"
            android:background="@drawable/bg_ripple_widget_note"
            android:contentDescription="@string/description_button_add"
            android:scaleType="centerInside"
            android:padding="4dp"/>
    </LinearLayout>
</LinearLayout>